# Backend environment variables (sample)

# Port for the backend server
REACT_APP_PORT=4000

# URL of the frontend (CORS allowed origin)
REACT_APP_FRONTEND_URL=http://localhost:3000

# Public base URL of this backend (used in Swagger "servers")
REACT_APP_BACKEND_URL=http://localhost:4000

# Health check path
REACT_APP_HEALTHCHECK_PATH=/healthz

# Trust proxy (true/false or 1/0)
REACT_APP_TRUST_PROXY=false

# Log level (morgan format)
REACT_APP_LOG_LEVEL=dev

# The variables below are listed for consistency across containers.
# They are not required by this backend, but may be present in shared tooling.
REACT_APP_API_BASE=http://localhost:4000/api
REACT_APP_WS_URL=
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=1
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=
