# Frontend environment variables
# Ensure the React app talks to the backend at http://localhost:4000 under /api
REACT_APP_API_BASE=http://localhost:4000/api

# Optional: If REACT_APP_API_BASE is not set, client.js will attempt a fallback:
# REACT_APP_BACKEND_URL + "/api"
# Example:
# REACT_APP_BACKEND_URL=http://localhost:4000
